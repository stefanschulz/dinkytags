<?xml version="1.0"?>
<ruleset name="DinkyTags">
    <description>
        PSR-12, the way the Joomla CMS itself lints since it dropped the joomla/coding-standards
        package (see joomla-cms/ruleset.xml). New code, so none of core's legacy exceptions apply.
    </description>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/.docker/*</exclude-pattern>
    <exclude-pattern>*/.releases/*</exclude-pattern>
    <exclude-pattern>*/.idea/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="report" value="full"/>
    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12"/>

    <!-- Warn on long lines, never fail on them: core allows far more than PSR-12's 120. -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="160"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
